

import dataiku
from dataikuapi.dss.wiki import DSSWiki

# Initialize the client for Dataiku 14.2
client = dataiku.api_client()
project_key = dataiku.default_project_key()
project = client.get_project(project_key)

def generate_api_docs():
    wiki = project.get_wiki()
    api_services = project.list_api_services()
    
    markdown_content = "# Project API Documentation\n\n"
    markdown_content += "This page is auto-generated to provide technical details for all API Services in this project.\n\n---\n"

    for service_summary in api_services:
        service = project.get_api_service(service_summary['id'])
        settings = service.get_settings()
        
        markdown_content += f"## API Service: {service_summary['id']}\n"
        
        # 1. API Documentation (Description/Metadata)
        description = settings.get_raw().get('description', 'No description provided.')
        markdown_content += f"**Description:** {description}\n\n"

        # 2. API Deployment Information
        # Note: In 14.2, we look at endpoints and basic service settings
        markdown_content += "### Deployment Info\n"
        markdown_content += f"- **Service ID:** `{service_summary['id']}`\n"
        markdown_content += f"- **End-points Count:** {len(settings.get_raw().get('endpoints', []))}\n\n"

        # Iterate through Endpoints to get Schemas
        for endpoint in settings.get_raw().get('endpoints', []):
            ep_id = endpoint.get('id')
            markdown_content += f"#### Endpoint: `{ep_id}`\n"
            
            # 3. Input Schema
            markdown_content += "**Input Schema:**\n"
            input_schema = endpoint.get('inputSchema', {}).get('columns', [])
            if input_schema:
                markdown_content += "| Name | Type |\n|---|---|\n"
                for col in input_schema:
                    markdown_content += f"| {col['name']} | {col['type']} |\n"
            else:
                markdown_content += "*No explicit input schema defined.*\n"

            # 4. Output Schema
            markdown_content += "\n**Output Schema:**\n"
            output_schema = endpoint.get('outputSchema', {}).get('columns', [])
            if output_schema:
                markdown_content += "| Name | Type |\n|---|---|\n"
                for col in output_schema:
                    markdown_content += f"| {col['name']} | {col['type']} |\n"
            else:
                markdown_content += "*Inherited or not defined.*\n"
            
            markdown_content += "\n---\n"

    # Create or update the Wiki Article
    article_id = "api-technical-docs"
    try:
        # Check if article exists
        article = wiki.get_article(article_id)
        article_data = article.get_data()
        article_data.set_body(markdown_content)
        article_data.save()
        print(f"Updated Wiki: {article_id}")
    except:
        # Create new if it doesn't exist
        wiki.create_article("API Technical Docs", content=markdown_content)
        print(f"Created new Wiki: {article_id}")

if __name__ == "__main__":
    generate_api_docs()























