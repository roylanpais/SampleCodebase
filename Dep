import dataiku
import dataikuapi
import json

# Initialize client and project
client = dataiku.api_client()
project_key = dataiku.default_project_key()
project = client.get_project(project_key)

def get_project_documentation():
    wiki = project.get_wiki()
    
    # 1. Start building Markdown content
    content = f"# Project Documentation: {project_key}\n\n"
    content += "## 1. Deploy Type\n"
    
    # Logic to determine deployment type
    api_services = project.list_api_services()
    scenarios = project.list_scenarios()
    
    is_realtime = len(api_services) > 0
    # Batch is often identified by existence of a 'Build' scenario or specific tags
    is_batch = any(s['active'] for s in scenarios) 

    if is_realtime:
        content += "* **Type:** Real-time API deployment\n"
    if is_batch:
        content += "* **Type:** Batch deployment\n"
    if not is_realtime and not is_batch:
        content += "* **Type:** Design-only / Manual\n"

    # 2. API Deployment Information
    content += "\n## 2. API Deployment Information\n"
    
    if not api_services:
        content += "No API Services defined in this project.\n"
    else:
        for service_summary in api_services:
            service = project.get_api_service(service_summary['id'])
            settings = service.get_settings()
            
            content += f"### Service: {service_summary['id']}\n"
            
            # API Documentation (Description)
            desc = settings.get_raw().get('description', 'No description provided.')
            content += f"**Documentation:** {desc}\n\n"
            
            # Extracting endpoints for Schema
            endpoints = settings.get_raw().get('endpoints', [])
            for ep in endpoints:
                content += f"#### Endpoint: {ep.get('id')}\n"
                
                # API Input Schema
                input_schema = ep.get('inputSchema', {}).get('columns', [])
                content += "**Input Schema:**\n"
                if input_schema:
                    content += "| Column | Type |\n|---|---|\n"
                    for col in input_schema:
                        content += f"| {col['name']} | {col['type']} |\n"
                else:
                    content += "*No specific input schema defined.*\n"
                
                # API Output Schema
                output_schema = ep.get('outputSchema', {}).get('columns', [])
                content += "\n**Output Schema:**\n"
                if output_schema:
                    content += "| Column | Type |\n|---|---|\n"
                    for col in output_schema:
                        content += f"| {col['name']} | {col['type']} |\n"
                else:
                    content += "*No specific output schema defined.*\n"
                content += "\n---\n"

    # 3. Create or Update the Wiki Page
    # Ensure a 'Documentation' article exists or create it
    try:
        article = wiki.get_article("project-auto-doc")
        article_data = article.get_data()
        article_data.set_body(content)
        article_data.save()
        print("Wiki updated successfully.")
    except:
        # Create new if it doesn't exist
        wiki.create_article("project-auto-doc", title="Automated Project Specs", 
                            parent_id=None, content=content)
        print("Wiki created successfully.")

if __name__ == "__main__":
    get_project_documentation()


