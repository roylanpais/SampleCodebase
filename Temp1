import dataiku
import pandas as pd

# Initialize the Dataiku client
client = dataiku.api_client()

# Fetch all connections available on the DSS instance
# Note: The user running this recipe must have sufficient permissions to view connections.
connections = client.list_connections()

results = []
print(f"Found {len(connections)} connections. Beginning tests...")

for conn_name, conn_def in connections.items():
    conn_type = conn_def.get("type", "Unknown")
    
    # Retrieve the connection object
    conn_obj = client.get_connection(conn_name)
    
    status = "UNKNOWN"
    message = ""
    
    try:
        # The test() method triggers Dataiku's internal connection verification
        test_result = conn_obj.test()
        
        if test_result.get("connectionOK"):
            status = "SUCCESS"
            message = "Connection is active and verified."
        else:
            status = "FAILED"
            # Extract detailed error message if the connection is dead
            message = test_result.get("errorMsg", "Connection failed. Check credentials or network access.")
            
    except Exception as e:
        # Some connection types (like certain local filesystems) do not support the test() method
        status = "SKIPPED / UNSUPPORTED"
        message = f"Testing not supported for this type or threw an exception: {str(e)}"
        
    results.append({
        "connection_name": conn_name,
        "connection_type": conn_type,
        "status": status,
        "message": message
    })

# Compile results into a pandas DataFrame
results_df = pd.DataFrame(results)

# Write the DataFrame to the Dataiku output dataset
output_dataset = dataiku.Dataset("Connection_Test_Results")
output_dataset.write_with_schema(results_df)

print("Connection testing complete. Results written to the dataset.")
