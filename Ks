import dataiku

# Get handles for the current project
client = dataiku.api_client()
project = client.get_project(dataiku.default_project_key())

def get_k8s_documentation():
    settings = project.get_settings()
    raw_settings = settings.get_raw()
    
    # 1. Get Default Containerized Execution Config
    # In Dataiku 14, this is stored under containerSettings
    container_settings = raw_settings.get("containerSettings", {})
    default_config = container_settings.get("executionConfig", "None (Inherited from Global)")

    # 2. List all Kubernetes configurations used in the project
    # We look for configurations referenced in the project's specific overrides
    # or used by specific recipes/notebooks if defined at project level
    configs_used = []
    
    # Check for project-level allowed configurations
    allowed_configs = container_settings.get("allowedExecutionConfigs", [])
    if allowed_configs:
        configs_used = allowed_configs
    else:
        configs_used = ["Using instance-wide default configurations"]

    # Format the Wiki Content
    wiki_content = f"## Kubernetes Cluster Documentation\n\n"
    wiki_content += f"### Default Execution Configuration\n"
    wiki_content += f"The default containerized execution config for this project is: **{default_config}**\n\n"
    wiki_content += f"### Kubernetes Container Configurations\n"
    wiki_content += "The following configurations are available/used in this project:\n"
    for config in configs_used:
        wiki_content += f"* {config}\n"
    
    return wiki_content

def update_wiki(content):
    wiki = project.get_wiki()
    article_id = "infrastructure-docs"
    
    try:
        # Check if article exists
        article = wiki.get_article(article_id)
        payload = article.get_payload()
        payload.set_content(content)
        article.save_payload(payload)
        print("Wiki article updated.")
    except:
        # Create new article if it doesn't exist
        wiki.create_article("Infrastructure Documentation", 
                            article_id=article_id, 
                            content=content)
        print("Wiki article created.")

# Run the automation
doc_content = get_k8s_documentation()
update_wiki(doc_content)






